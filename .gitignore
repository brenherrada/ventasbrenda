# Local dependencies and Netlify CLI state
node_modules/
.netlify/

# npm/package-lock.json is the dependency source; local tool-generated files stay out.
/pnpm-lock.yaml
/pnpm-workspace.yaml
/deno.lock

# Secrets and local environment configuration
.env
.env.*
!.env.example

# Generated builds, caches and QA artifacts
/dist/
/output/
/tmp/
.cache/
.playwright-cli/
playwright-report/
test-results/
*.log

# Obsolete distribution archives
*.zip

# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
